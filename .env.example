# cp .env.example .env.local 후 값을 채운다. .env.local은 커밋되지 않는다.
# 규칙은 docs/security.md

# 백엔드(Spring) 주소. 끝에 / 를 붙이지 않는다. 예: http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=

# 카카오 지도 JavaScript 키 (카카오 개발자 앱 「Tour Navigator」 > 앱 키 > JavaScript 키).
# 브라우저에 노출되는 키라서, 앱의 「JavaScript SDK 도메인」에 등록한 주소에서만 동작한다.
# 등록 주소: http://localhost:5173, https://tour-navigator.vercel.app (127.0.0.1로 열면 동작하지 않는다)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ── 여기부터 서버 전용. NEXT_PUBLIC_ 을 붙이지 않고 Route Handler에서만 읽는다 ──

# 공공데이터포털 서비스키 (한국관광공사 TourAPI · 한국공항공사 공용). 공공데이터포털의 「디코딩」 키를 넣는다.
# 장소 시트의 오디오 가이드 · 함께 많이 가는 관광지 · 방문 집중률 예측(app/api/tour/*)은 한국관광공사 세 API 활용신청이 필요하다:
# 관광지 오디오 가이드정보 · 관광지별 연관 관광지 정보 · 관광지 집중률 방문자 추이 예측 정보. 키가 없으면 그 칸들이 숨는다
# 같은 키로 다음 두 서비스도 부른다(각각 활용신청 필요, 신청하지 않으면 그 칸만 숨는다):
#   한국환경공단_에어코리아_대기오염정보(장소 시트 날씨 칸의 미세먼지, app/api/air)
#   한국공항공사_공항 소요시간 정보(플래너 항공편 카드의 지금 수속 소요, app/api/airport/process)
#   한국관광공사_국문 관광정보 서비스_GW · 관광사진 정보_GW(장소 시트 대표 사진, app/api/tour/photo. 키가 없으면 위키백과만 본다)
DATA_GO_KR_KEY=

# 공용 테스트 계정(백엔드에 가입해 둔 계정). 둘 다 있으면 로그인 화면에 「테스트 계정으로 로그인」이 보이고,
# 로그인은 app/api/auth/demo가 서버에서 대신 한다(비밀번호를 브라우저에 보내지 않는다). 없으면 버튼이 숨는다
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=

# Kakao REST API 키(서버 전용): 장소 시트 대표 사진 마지막 단계 카카오 이미지 검색(app/api/tour/photo), 좌표 보정 스크립트
KAKAO_REST_KEY=

# YouTube Data API v3 키
YOUTUBE_API_KEY=

# 한국도로공사 공공데이터 키 (휴게소 목록)
EXROAD_KEY=

# TMDB API 키 v3 (테마 화면의 작품 정보 카드)
TMDB_API_KEY=

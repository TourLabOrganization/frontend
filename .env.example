# cp .env.example .env.local 후 값을 채운다. .env.local은 커밋되지 않는다.
# 규칙은 docs/security.md

# 백엔드(Spring) 주소. 끝에 / 를 붙이지 않는다. 예: http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=

# Google Maps JavaScript API. 브라우저에 노출되는 키라서
# Google Cloud 콘솔에서 HTTP 리퍼러(배포 도메인·localhost) 제한을 반드시 건다
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── 여기부터 서버 전용. NEXT_PUBLIC_ 을 붙이지 않고 Route Handler에서만 읽는다 ──

# 공공데이터포털 서비스키 (한국관광공사 TourAPI · 한국공항공사 공용)
DATA_GO_KR_KEY=

# Kakao REST API 키
KAKAO_REST_KEY=

# YouTube Data API v3 키
YOUTUBE_API_KEY=

# 한국도로공사 공공데이터 키 (휴게소 목록)
EXROAD_KEY=

# TMDB API 키 v3 (테마 화면의 작품 정보 카드)
TMDB_API_KEY=
